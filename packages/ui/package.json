{
  "name": "@lo-fi-rocket/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable React building blocks for the redesigned app. Display only: no physics, no calculation.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "mockups": "vite build --config mockups/vite.config.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "4.11.4",
    "jsdom": "30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.0.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
