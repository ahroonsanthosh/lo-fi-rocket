{
  "name": "@lo-fi-rocket/app",
  "version": "0.0.0",
  "private": true,
  "description": "React frontend for the rocket design and flight simulator.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/lato": "5.2.7",
    "@lo-fi-rocket/formats": "workspace:*",
    "@lo-fi-rocket/mcp": "workspace:*",
    "@lo-fi-rocket/physics": "workspace:*",
    "@lo-fi-rocket/ui": "workspace:*",
    "@lo-fi-rocket/viewer": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.2",
    "vite": "^8.0.0"
  }
}
